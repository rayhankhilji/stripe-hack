# Ghost — environment variables. Names only; values here are fake.
# Cloud sessions read real values from the environment's settings (never commit a real .env).
# Validated at boot by packages/shared/src/env.ts. See docs/ARCHITECTURE.md §12.

# --- Era (Sapora Networks synthetic company, read-only MCP) ---
ERA_TOKEN_URL=https://console.era.eon.io/token
ERA_CLIENT_ID=sim-0000000000000000
ERA_CLIENT_SECRET=replace-me
ERA_MCP_BASE_DOMAIN=era.eon.io            # URLs are https://<system>-mcp.<domain>/mcp/

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- OpenAI (Mastra agents + Cognee LLM/embeddings) ---
OPENAI_API_KEY=sk-proj-replace-me
GHOST_REASONING_MODEL=gpt-5.1            # verified at P0.T4/P1 against the account's model list
GHOST_FAST_MODEL=gpt-5.1-mini

# --- Cognee (REST server, services/cognee) ---
COGNEE_BASE_URL=http://localhost:8000
COGNEE_USERNAME=default_user@example.com
COGNEE_PASSWORD=replace-me
COGNEE_DATASET=sapora

# --- Stripe (TEST MODE ONLY: keys must start with sk_test_/pk_test_) ---
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_INVOICE_DAYS_UNTIL_DUE=30

# --- App ---
APP_BASE_URL=http://localhost:3000
OPERATOR_PASSWORD=replace-me
SESSION_SECRET=replace-me-with-32-plus-random-chars
DEMO_MODE=true                            # enables POST /api/v1/demo/reset
AUTO_INVOICE_ENABLED=false                # policy: every invoice needs human approval
INVOICE_AMOUNT_CAP_CENTS=10000000         # R-09: $100,000 per invoice
OUTBOX_SANDBOX_DOMAIN=sandbox.ghost.test  # all simulated email goes here
LOG_LEVEL=info

# --- Deploy (W2 deploy cards only) ---
VERCEL_TOKEN=replace-me
RAILWAY_TOKEN=replace-me
