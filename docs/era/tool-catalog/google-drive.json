[
 {
  "name": "list_files",
  "description": "List Drive files, newest first, optionally within one folder or matching a Drive ``q``. Mirrors ``GET /drive/v3/files``.\n\n        ``order_by`` takes Drive's syntax (``name``, ``modifiedTime desc``, ...).\n        ``corpora`` scopes the search the way ``files.list`` does: ``user`` is My\n        Drive only (REST's default), ``drive`` one shared drive, ``allDrives`` both\n        (the default here, since an agent asking \"what files exist\" means all of them).\n        ",
  "readOnly": true,
  "inputSchema": {
   "properties": {
    "page_size": {
     "default": 100,
     "title": "Page Size",
     "type": "integer"
    },
    "page_token": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Page Token"
    },
    "folder_id": {
     "default": "",
     "title": "Folder Id",
     "type": "string"
    },
    "query": {
     "default": "",
     "title": "Query",
     "type": "string"
    },
    "include_trashed": {
     "default": false,
     "title": "Include Trashed",
     "type": "boolean"
    },
    "order_by": {
     "default": "",
     "title": "Order By",
     "type": "string"
    },
    "corpora": {
     "default": "allDrives",
     "enum": [
      "user",
      "drive",
      "allDrives"
     ],
     "title": "Corpora",
     "type": "string"
    },
    "drive_id": {
     "default": "",
     "title": "Drive Id",
     "type": "string"
    }
   },
   "title": "list_filesArguments",
   "type": "object"
  }
 },
 {
  "name": "list_recent_files",
  "description": "The user's most recent files, newest first. Mirrors ``GET /drive/v3/files?orderBy=recency desc``.\n\n        ``order_by`` matches Google's Drive MCP server: ``recency`` (any timestamp),\n        ``lastModified`` (modified by anyone) or ``lastModifiedByMe``; that server's\n        camelCase ``orderBy``/``pageSize``/``pageToken`` are accepted too.\n        ",
  "readOnly": true,
  "inputSchema": {
   "properties": {
    "order_by": {
     "default": "recency",
     "enum": [
      "recency",
      "lastModified",
      "lastModifiedByMe"
     ],
     "title": "Order By",
     "type": "string"
    },
    "page_size": {
     "default": 10,
     "title": "Page Size",
     "type": "integer"
    },
    "page_token": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Page Token"
    },
    "orderBy": {
     "anyOf": [
      {
       "enum": [
        "recency",
        "lastModified",
        "lastModifiedByMe"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Orderby"
    },
    "pageSize": {
     "default": 0,
     "title": "Pagesize",
     "type": "integer"
    },
    "pageToken": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Pagetoken"
    },
    "excludeContentSnippets": {
     "default": false,
     "title": "Excludecontentsnippets",
     "type": "boolean"
    }
   },
   "title": "list_recent_filesArguments",
   "type": "object"
  }
 },
