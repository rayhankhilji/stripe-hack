 {
  "name": "slack_auth_test",
  "description": "Who this token is: the member or bot it acts as, its workspace, and its app.\n\n        The MCP surface had no identity tool, so an agent holding a user credential had\n        no way to learn whose messages, DMs and private channels it was reading \u2014 and\n        anything it inferred from ``slack_get_users`` was the workspace's first member,\n        not itself. This is ``auth.test`` under the MCP transport, answering from the\n        same payload for the same caller.\n        ",
  "readOnly": true,
  "inputSchema": {
   "properties": {},
   "title": "slack_auth_testArguments",
   "type": "object"
  }
 },
